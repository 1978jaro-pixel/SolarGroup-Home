# SolarGroup Home – lokálna konfigurácia.
# Skopírujte do súboru backend/.env a upravte. Súbor .env sa NIKDY necommituje.

# Režim: demo (simulované údaje, jasne označené) | live (iba skutočné údaje z adaptérov)
SGH_MODE=demo

# Predvolene počúva iba na tomto počítači. Pre prístup z domácej siete (LAN)
# nastavte 0.0.0.0 – NIKDY nepresmerúvajte port na routri do internetu.
SGH_HOST=127.0.0.1
SGH_PORT=8080

# Adresár s databázou SQLite (relatívne k adresáru backend/)
SGH_DATA_DIR=data

# Platnosť prihlásenia v hodinách
SGH_SESSION_HOURS=12
# Nastavte true, ak beží za HTTPS reverse proxy
SGH_COOKIE_SECURE=false

# Za koľko sekúnd sa údaje označia ako zastarané
SGH_STALE_AFTER_SECONDS=120

# Časové pásmo domácnosti (týždenné programy kúrenia, časovače klimatizácie)
SGH_TIMEZONE=Europe/Bratislava

# --- Integrácie (LIVE) ---
# Existujúci SolarGroup Dashboard (iba čítanie cez jeho API, kód sa nemení)
# SGH_SOLARGROUP_URL=http://192.168.1.50:8000
# SGH_SOLARGROUP_TOKEN=

# Počasie pre Žilinu cez Open-Meteo (vyžaduje internet; bez neho sa zobrazí OFFLINE)
SGH_WEATHER_ENABLED=true
SGH_WEATHER_LAT=49.2231
SGH_WEATHER_LON=18.7394
