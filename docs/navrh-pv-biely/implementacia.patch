diff --git a/frontend/src/styles/global.css b/frontend/src/styles/global.css
index f0658d3..0de829b 100644
--- a/frontend/src/styles/global.css
+++ b/frontend/src/styles/global.css
@@ -3588,7 +3588,7 @@ html.kiosk textarea {
   margin-bottom: 16px;
 }
 .pv-hero .pvs {
-  width: min(100%, calc((100dvh - var(--header-h) - var(--nav-h) - 96px) * 1.5));
+  width: min(100%, calc((100dvh - var(--header-h) - var(--nav-h) - 66px) * 1.5)); /* o ~8 % väčší dom */
